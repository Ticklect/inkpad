import { LineEdit, ScrollView, Slider, SpinBox } from "std-widgets.slint";

export struct NoteRow {
    id: string,
    title: string,
    subtitle: string,
    kind: string,
    active: bool,
    pinned: bool,
}

// A saved picture belongs to a page, with its own order and display width.
export struct MediaRow {
    id: string,
    caption: string,
    width-percent: int,
    position: int,
    preview: image,
}

// The native host pre-splits rich text into Unicode-safe word/whitespace spans.
// Flexbox wraps at span boundaries; the host must fall back to StyledText for
// complex shaping/bidirectional text or exceptionally large notes.
export struct RichPreviewSpan {
    text: string,
    size: int,
    family: string,
    bold: bool,
    foreground: color,
    has_foreground: bool,
}

export struct RichPreviewParagraph {
    spans: [RichPreviewSpan],
}

// Palette shared by the notebook chrome, controls, pictures and dialogs.
// The host persists appearance-theme; the effective dark flag follows it.
global InkTheme {
    in-out property <bool> dark: false;
    out property <color> canvas: dark ? #181d25 : #fffefa;
    out property <color> paper: dark ? #232a34 : #ffffff;
    out property <color> toolbar: dark ? #202732 : #fbfaf8;
    out property <color> sidebar: dark ? #1c232c : #f4f1eb;
    out property <color> chrome: dark ? #202631 : #f6f3ee;
    out property <color> secondary: dark ? #2c3541 : #f5f3ef;
    out property <color> line: dark ? #3c4552 : #e9e5dd;
    out property <color> ink: dark ? #eef1f6 : #292927;
    out property <color> muted: dark ? #b5bfcd : #6d6962;
    out property <color> subtle: dark ? #8995a5 : #948d80;
    out property <color> accent: dark ? #eec36b : #b98b37;
}

// A compact button that stays accessible to mouse, keyboard, and screen readers.
component KeyboardTarget {
    in property <bool> enabled: true;
    out property <bool> has-hover <=> mouse-surface.has-hover;
    out property <bool> has-focus <=> keyboard.has-focus;
    callback clicked <=> mouse-surface.clicked;
    callback pressing(bool);
    callback focus-keyboard();
    focus-keyboard => { keyboard.focus(); }
    forward-focus: keyboard;
    keyboard := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                mouse-surface.clicked();
                return accept;
            }
            return reject;
        }
    }
    mouse-surface := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.pressing(true);
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.pressing(false);
            }
        }
    }
}

component ActionButton inherits Rectangle {
    in property <bool> dark: InkTheme.dark;
    in property <string> label: "";
    in property <string> accessible-name: "";
    in property <bool> selected: false;
    in property <bool> prominent: false;
    in property <bool> danger: false;
    in property <bool> destructive: false;
    in property <bool> enabled: true;
    in property <bool> subtle: false;
    callback clicked();
    callback focus-button();
    focus-button => { hit.focus-keyboard(); }
    out property <bool> has-keyboard-focus <=> hit.has-focus;

    height: 36px;
    min-width: 30px;
    border-radius: 9px;
    border-width: 1px;
    border-color: hit.has-focus ? #d8aa55 : root.destructive ? #ae584f : root.prominent ? #c8972a : root.selected ? #c99b44 : root.dark ? #454c59 : root.subtle ? #e9e5df : #dfddd8;
    background: !root.enabled ? (root.dark ? #252b35 : #f3f1ed) : root.destructive ? (hit.has-hover ? #9f4138 : #b24c41) : root.prominent ? #e6b846 : root.selected ? (root.dark ? #514129 : #f9e8b2) : hit.has-hover ? (root.dark ? #353d49 : root.danger ? #f8e6e3 : #eeece6) : root.subtle ? transparent : root.dark ? #282f39 : #ffffff;
    accessible-role: button;
    accessible-label: root.accessible-name == "" ? root.label : root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: hit;
    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        font-family: "Segoe UI";
        font-size: 12px;
        font-weight: 600;
        color: !root.enabled ? (root.dark ? #697482 : #a7a39b) : root.destructive ? #ffffff : root.prominent ? #352b16 : root.danger ? (root.dark ? #f2a79d : #b25046) : root.selected ? (root.dark ? #f5d58d : #6e5219) : root.dark ? #eceef3 : #494945;
    }
    hit := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Geometry-based icons render in the same position at every font and DPI scale.
component PencilMark inherits Rectangle {
    in property <color> ink: #684d17;
    background: transparent;
    width: 22px;
    height: 22px;
    Path {
        width: parent.width;
        height: parent.height;
        commands: "M 3 16 L 14.8 4.2 L 18 7.4 L 6.2 19.2 L 2.6 19.5 Z";
        fill: root.ink;
    }
}

component SearchMark inherits Rectangle {
    background: transparent;
    width: 20px;
    height: 20px;
    Rectangle {
        x: 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-width: 1.5px;
        border-color: #89837a;
        border-radius: 6px;
        background: transparent;
    }
    Rectangle {
        x: 11px;
        y: 15px;
        width: 8px;
        height: 1.5px;
        border-radius: 1px;
        transform-rotation: 45deg;
        background: #89837a;
    }
}

component DocumentMark inherits Rectangle {
    in property <color> ink: #94856c;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle {
        x: 4px;
        y: 2px;
        width: 14px;
        height: 18px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: root.ink;
        background: transparent;
    }
    for y in [8px, 12px, 16px]: Rectangle {
        x: 7px;
        y: y;
        width: 8px;
        height: 1px;
        background: root.ink;
    }
}

component ToolLabel inherits Rectangle {
    in property <string> label: "";
    in property <color> ink: #6f6a60;
    height: 34px;
    background: transparent;
    Text {
        text: root.label;
        width: parent.width;
        height: parent.height;
        color: root.ink;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}

component StepButton inherits Rectangle {
    in property <bool> dark: InkTheme.dark;
    in property <bool> add: false;
    in property <bool> enabled: true;
    in property <bool> hold-mode: false;
    private property <bool> held: false;
    private property <bool> repeating: false;
    private property <bool> focus-active: hit.has-focus;
    callback clicked();
    changed enabled => {
        if (!root.enabled) {
            root.held = false;
            root.repeating = false;
        }
    }
    // A grabbed pointer may keep delivering move events after it leaves the button.
    // Releasing keyboard/window focus must also halt a running repeat.
    changed focus-active => {
        if (!root.focus-active) {
            root.held = false;
            root.repeating = false;
        }
    }
    width: 32px;
    height: 34px;
    border-width: 1px;
    border-color: hit.has-focus ? #d8aa55 : root.dark ? #454c59 : #dfddd8;
    border-radius: 8px;
    background: hit.has-hover && root.enabled ? (root.dark ? #39414e : #ede9e0) : root.dark ? #282f39 : #ffffff;
    accessible-role: button;
    accessible-label: root.add ? "Increase size" : "Decrease size";
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: hit;
    Rectangle {
        width: 10px;
        height: 1.5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        background: root.enabled ? (root.dark ? #edf0f5 : #44413c) : #aaa69f;
    }
    if root.add: Rectangle {
        width: 1.5px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        background: root.enabled ? (root.dark ? #edf0f5 : #44413c) : #aaa69f;
    }
    hit := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Timer {
        interval: 360ms;
        running: root.enabled && root.held && !root.repeating;
        triggered => { root.repeating = true; }
    }
    Timer {
        interval: 75ms;
        running: root.enabled && root.held && root.repeating;
        triggered => { if (root.enabled && root.held) { root.clicked(); } }
    }
    if root.hold-mode: hold-hit := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && !root.held) {
                hit.focus-keyboard();
                root.held = true;
                root.repeating = false;
                root.clicked();
            }
            // A pointer grab does not guarantee that has-hover becomes false on exit.
            // Stop as soon as the pointer leaves; moving back inside will not restart
            // until a fresh down event, preventing an unexpected runaway repeat.
            if (event.kind == PointerEventKind.move &&
                (self.mouse-x < 0px || self.mouse-x >= self.width ||
                 self.mouse-y < 0px || self.mouse-y >= self.height)) {
                root.held = false;
                root.repeating = false;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.held = false;
                root.repeating = false;
            }
        }
    }
}

component DeleteRowButton inherits Rectangle {
    in property <string> note-name: "";
    callback clicked();
    width: 32px;
    height: 34px;
    border-radius: 7px;
    background: hit.has-hover ? (InkTheme.dark ? #503d45 : #f4dcd8) : transparent;
    border-width: hit.has-focus ? 1px : 0px;
    border-color: #b25046;
    accessible-role: button;
    accessible-label: "Delete " + root.note-name;
    accessible-action-default => { root.clicked(); }
    forward-focus: hit;
    Rectangle {
        width: 14px;
        height: 1.5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        transform-rotation: 45deg;
        background: #ba5348;
    }
    Rectangle {
        width: 14px;
        height: 1.5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 1px;
        transform-rotation: -45deg;
        background: #ba5348;
    }
    hit := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// A geometry-based sidebar control; the entire 34px surface is keyboard actionable.
component SidebarToggle inherits Rectangle {
    in property <bool> collapsed: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: root.enabled && hit.has-hover ? (InkTheme.dark ? #343b48 : #e7e3dc) : transparent;
    border-width: hit.has-focus ? 1px : 0px;
    border-color: #bb923f;
    accessible-role: button;
    accessible-label: root.collapsed ? "Expand sidebar" : "Collapse sidebar";
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: hit;
    Rectangle {
        x: (parent.width - 17px) / 2;
        y: (parent.height - 15px) / 2;
        width: 17px;
        height: 15px;
        border-width: 1px;
        border-color: #827d72;
        border-radius: 3px;
        background: transparent;
    }
    Rectangle {
        x: (parent.width - 17px) / 2 + (root.collapsed ? 5px : 10px);
        y: (parent.height - 15px) / 2;
        width: 1px;
        height: 15px;
        background: #827d72;
    }
    hit := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component ChromeButton inherits Rectangle {
    in property <string> symbol: "";
    in property <string> action-name: "";
    in property <bool> close-button: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 44px;
    height: 40px;
    background: root.enabled && hit.has-hover ? (root.close-button ? #c8574e : InkTheme.dark ? #363f4d : #e8e5de) : transparent;
    accessible-role: button;
    accessible-label: root.action-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: hit;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.symbol;
        font-family: "Segoe UI";
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.enabled ? #aaa59e : hit.has-hover && root.close-button ? #ffffff : InkTheme.dark ? #c8d1de : #655e54;
    }
    hit := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component NewPageButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();
    height: 42px;
    background: hit.has-hover ? InkTheme.paper : InkTheme.toolbar;
    border-width: 1px;
    border-color: hit.has-focus ? #b98b37 : InkTheme.line;
    border-radius: 10px;
    accessible-role: button;
    accessible-label: "New page";
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: hit;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            width: 25px;
            height: 25px;
            border-radius: 7px;
            background: #ebc875;
            Rectangle {
                width: 11px;
                height: 1.5px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #604d28;
                border-radius: 1px;
            }
            Rectangle {
                width: 1.5px;
                height: 11px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #604d28;
                border-radius: 1px;
            }
        }
        Text {
            text: "New page";
            font-size: 13px;
            font-weight: 600;
            color: InkTheme.ink;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }
    hit := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component ColorDot inherits Rectangle {
    in property <color> paint: #242f32;
    in property <string> value: "#242F32";
    in property <string> label: "Black";
    in property <string> category: "brush";
    in property <bool> selected: false;
    callback picked(string);
    width: 29px;
    height: 29px;
    border-radius: 15px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? #e1b558 : InkTheme.line;
    background: InkTheme.paper;
    accessible-role: button;
    accessible-label: root.label + " " + root.category;
    accessible-action-default => { root.picked(root.value); }
    forward-focus: hit;
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: 12px;
        background: root.paint;
    }
    hit := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        clicked => { root.picked(root.value); }
    }
}

component MediaCard inherits Rectangle {
    in property <string> media-id: "";
    in property <string> caption: "";
    in property <int> width-percent: 100;
    in property <int> position: 0;
    in property <image> preview;
    in property <bool> selected: false;
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    callback chosen(string);
    callback resized(string, int);
    callback moved(string, int);
    callback removed(string);
    callback caption-changed(string, string);

    // Scaling a picture changes the page's vertical footprint as well as its width.
    // Keep 192px for the header, resize controls, caption and spacing.
    height: 272px + min(100, max(10, root.width-percent)) * 1.3px;
    border-radius: 13px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? #d6a645 : InkTheme.line;
    background: InkTheme.paper;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        HorizontalLayout {
            height: 23px;
            spacing: 7px;
            Text {
                text: "PHOTO " + (root.position + 1);
                color: InkTheme.muted;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.width-percent + "% OF PAGE";
                color: InkTheme.muted;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 80px + min(100, max(10, root.width-percent)) * 1.3px;
            background: InkTheme.secondary;
            border-radius: 8px;
            clip: true;
            accessible-role: button;
            accessible-label: root.caption == "" ? "Select photo " + (root.position + 1) : "Select photo: " + root.caption;
            accessible-action-default => { root.chosen(root.media-id); }
            forward-focus: photo-hit;
            Image {
                width: max(56px, (parent.width - 16px) * root.width-percent / 100);
                height: parent.height - 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.preview;
                image-fit: contain;
            }
            photo-hit := KeyboardTarget {
                width: parent.width;
                height: parent.height;
                clicked => { root.chosen(root.media-id); }
            }
        }
        HorizontalLayout {
            height: 33px;
            spacing: 5px;
            ToolLabel { width: 42px; label: "SIZE"; ink: InkTheme.muted; }
            for size in [25, 50, 75, 100]: ActionButton {
                width: 43px;
                height: 30px;
                label: size + "%";
                accessible-name: "Show image at " + size + " percent of page width";
                selected: root.width-percent == size;
                clicked => { root.resized(root.media-id, size); }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            ActionButton {
                width: 43px;
                height: 30px;
                label: "↑";
                accessible-name: "Move photo up";
                enabled: root.can-move-up;
                clicked => { root.moved(root.media-id, -1); }
            }
            ActionButton {
                width: 43px;
                height: 30px;
                label: "↓";
                accessible-name: "Move photo down";
                enabled: root.can-move-down;
                clicked => { root.moved(root.media-id, 1); }
            }
            ActionButton {
                width: 71px;
                height: 30px;
                label: "Remove";
                accessible-name: "Remove this photo from page";
                danger: true;
                clicked => { root.removed(root.media-id); }
            }
        }
        HorizontalLayout {
            height: 34px;
            spacing: 11px;
            ToolLabel { width: 59px; label: "RESIZE"; ink: InkTheme.muted; }
            Slider {
                horizontal-stretch: 1;
                height: 28px;
                minimum: 10;
                maximum: 100;
                value: root.width-percent;
                accessible-label: "Picture width, 10 to 100 percent";
                changed(value) => { root.resized(root.media-id, Math.round(value)); }
            }
            Text {
                width: 42px;
                text: root.width-percent + "%";
                font-size: 12px;
                font-weight: 700;
                color: InkTheme.ink;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            ToolLabel { width: 59px; label: "CAPTION"; ink: InkTheme.muted; }
            LineEdit {
                horizontal-stretch: 1;
                height: 33px;
                text: root.caption;
                placeholder-text: "Add a caption…";
                accessible-label: "Photo caption";
                font-size: 12px;
                edited(value) => { root.caption-changed(root.media-id, value); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Inkpad Beta";
    icon: @image-url("../assets/inkpad-icon-preview.png");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1330px;
    preferred-height: 830px;
    min-width: 1010px;
    min-height: 660px;
    default-font-family: "Segoe UI";
    background: InkTheme.canvas;

    in property <[NoteRow]> rows: [];
    in property <[MediaRow]> media-rows: [];
    in-out property <string> selected-media-id: "";
    in-out property <string> appearance-theme: "light";
    in property <bool> system-dark: false;
    in property <bool> selection-bold: false;
    in property <string> text-color: "#292927";
    in property <int> selected-text-size: 0;
    in property <string> selected-text-family: "";
    in property <styled-text> note-styled-preview;
    in property <[RichPreviewParagraph]> rich-preview-paragraphs: [];
    // Set by the host ONLY when wrapping per-run spans is appropriate.
    in property <bool> rich-preview-exact: false;
    in-out property <bool> formatted-preview: false;
    in-out property <int> format-start: 0;
    in-out property <int> format-end: 0;
    // UTF-8 byte offsets reported by Slint TextInput (not Unicode scalar indices).
    // The Rust host converts these into the format-start/end character indices.
    in-out property <int> selection-anchor-byte: 0;
    in-out property <int> selection-caret-byte: 0;
    in-out property <bool> advanced-text-range: false;
    in-out property <string> custom-text-color: "#292927";
    private property <bool> text-editor-focused: false;
    private property <int> restore-editor-token: 0;
    in-out property <string> note-title: "";
    in-out property <string> note-body: "";
    in-out property <int> font-size: 17;
    in-out property <string> font-choice: "Sans";
    in-out property <string> active-kind: "note";
    in-out property <string> edit-mode: "text";
    in-out property <bool> has-note: false;
    in-out property <image> canvas-image;
    in-out property <string> search-query: "";
    in-out property <string> filter-kind: "all";
    in-out property <int> brush-size: 6;
    in-out property <string> brush-color: "#263238";
    in-out property <bool> eraser: false;
    in-out property <string> save-status: "Ready";
    in-out property <int> note-count: 0;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> delete-confirm-open: false;
    in property <string> delete-confirm-title: "";
    in property <string> delete-confirm-body: "";
    in property <string> confirm-action-label: "Delete page";

    callback new-note(string);
    callback select-note(string);
    callback delete-note();
    callback delete-note-by-id(string);
    callback rename-note(string);
    callback edit-body(string);
    callback set-edit-mode(string);
    callback change-font-size(int);
    callback change-font-choice(string);
    callback toggle-pin();
    callback draw-at(int, int, int);
    callback set-brush-size(int);
    callback set-brush-color(string);
    callback set-eraser(bool);
    callback undo-board();
    callback clear-board();
    callback export-current();
    callback save-now();
    callback set-filter(string);
    callback search(string);
    callback toggle-sidebar();
    callback request-delete-note(string);
    callback confirm-delete();
    callback cancel-delete();
    callback request-clear-board();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback paste-image();
    callback insert-image-file();
    callback select-media(string);
    callback resize-media(string, int);
    callback move-media(string, int);
    callback delete-media(string);
    callback caption-media(string, string);
    callback export-page();
    callback change-appearance-theme(string);
    callback request-formatted-preview();
    callback apply-text-format(string);
    callback apply-text-color(string);
    callback select-body-range(int, int);
    callback undo-rich-edit();
    callback redo-rich-edit();
    // Return false when no rich fragment applies; native TextInput then handles
    // the ordinary plain-text clipboard shortcut without any interference.
    callback copy-rich-selection() -> bool;
    callback cut-rich-selection() -> bool;
    callback paste-rich-selection() -> bool;
    public function restore-text-selection() {
        // Body TextInput lives inside the note view's conditional tree. It watches
        // this token locally so the root need not reference a scoped child id.
        if (!root.advanced-text-range && !root.formatted-preview) {
            root.restore-editor-token += 1;
        }
    }

    private property <color> ink: InkTheme.ink;
    private property <color> muted: InkTheme.muted;
    private property <color> line: InkTheme.line;
    private property <string> active-text-family: root.selected-text-family == "" ? root.font-choice : root.selected-text-family;
    private property <bool> renaming: false;
    changed appearance-theme => {
        InkTheme.dark = root.appearance-theme == "dark" || (root.appearance-theme == "system" && root.system-dark);
    }
    changed system-dark => {
        InkTheme.dark = root.appearance-theme == "dark" || (root.appearance-theme == "system" && root.system-dark);
    }
    changed delete-confirm-open => {
        if (root.delete-confirm-open) {
            modal-cancel.focus-button();
        }
    }

    forward-focus: shortcut-scope;
    shortcut-scope := FocusScope {
        // The main window must not accept focus or actions while a modal is open.
        enabled: !root.delete-confirm-open;
        KeyBinding {
            keys: @keys(Control + B);
            activated => {
                if (!root.delete-confirm-open) { root.toggle-sidebar(); }
            }
        }
        KeyBinding {
            keys: @keys(Control + Alt + B);
            activated => {
                if (!root.delete-confirm-open && root.has-note && root.edit-mode == "text" && root.text-editor-focused && !root.formatted-preview) {
                    root.apply-text-format("bold");
                    root.restore-text-selection();
                }
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.delete-confirm-open) { root.cancel-delete(); }
            }
        }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 40px;
            background: InkTheme.chrome;
            WindowMoveArea {
                HorizontalLayout {
                    padding-left: 18px;
                    spacing: 0px;
                    Rectangle {
                        width: 18px;
                        height: 40px;
                        background: transparent;
                        PencilMark {
                            width: 15px;
                            height: 15px;
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            ink: #9a813d;
                        }
                    }
                    Rectangle {
                        width: 124px;
                        height: 40px;
                        background: transparent;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Inkpad Beta";
                            font-size: 12px;
                            font-weight: 600;
                            color: InkTheme.muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 171px;
                        height: 40px;
                        background: transparent;
                        HorizontalLayout {
                            spacing: 4px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            ActionButton {
                                width: 52px;
                                height: 28px;
                                label: "Light";
                                selected: root.appearance-theme == "light";
                                accessible-name: "Use light appearance";
                                enabled: !root.delete-confirm-open;
                                clicked => { root.appearance-theme = "light"; root.change-appearance-theme("light"); }
                            }
                            ActionButton {
                                width: 52px;
                                height: 28px;
                                label: "Dark";
                                selected: root.appearance-theme == "dark";
                                accessible-name: "Use dark appearance";
                                enabled: !root.delete-confirm-open;
                                clicked => { root.appearance-theme = "dark"; root.change-appearance-theme("dark"); }
                            }
                            ActionButton {
                                width: 52px;
                                height: 28px;
                                label: "Auto";
                                selected: root.appearance-theme == "system";
                                accessible-name: "Follow system appearance";
                                enabled: !root.delete-confirm-open;
                                clicked => { root.appearance-theme = "system"; root.change-appearance-theme("system"); }
                            }
                        }
                    }
                    ChromeButton {
                        symbol: "−";
                        action-name: "Minimize window";
                        enabled: !root.delete-confirm-open;
                        clicked => { if (!root.delete-confirm-open) { root.window-minimize(); } }
                    }
                    ChromeButton {
                        symbol: "□";
                        action-name: "Maximize or restore window";
                        enabled: !root.delete-confirm-open;
                        clicked => { if (!root.delete-confirm-open) { root.window-toggle-maximize(); } }
                    }
                    ChromeButton {
                        symbol: "×";
                        close-button: true;
                        action-name: "Close window";
                        enabled: !root.delete-confirm-open;
                        clicked => { if (!root.delete-confirm-open) { root.window-close(); } }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #e3ded5;
            }
        }
        HorizontalLayout {
        spacing: 0px;

        // Persistent navigation; collapsed state is stored by the Rust host.
        Rectangle {
            width: root.sidebar-collapsed ? 60px : 278px;
            background: InkTheme.sidebar;
            border-width: 0px;
            if !root.sidebar-collapsed: VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 17px;
                padding-bottom: 15px;
                spacing: 0px;

                HorizontalLayout {
                    height: 52px;
                    spacing: 8px;
                    Rectangle {
                        width: 174px;
                        height: 52px;
                        background: transparent;
                        Text {
                            y: 7px;
                            width: parent.width;
                            height: 25px;
                            text: "Library";
                            font-family: "Segoe UI";
                            font-weight: 700;
                            font-size: 17px;
                            color: root.ink;
                            vertical-alignment: center;
                        }
                        Text {
                            y: 33px;
                            width: parent.width;
                            height: 14px;
                            text: "YOUR PAGES";
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1.1px;
                            color: InkTheme.muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    SidebarToggle {
                        collapsed: root.sidebar-collapsed;
                        enabled: !root.delete-confirm-open;
                        clicked => { if (!root.delete-confirm-open) { root.toggle-sidebar(); } }
                    }
                }

                Rectangle { height: 15px; background: transparent; }

                HorizontalLayout {
                    height: 42px;
                    spacing: 8px;
                    NewPageButton {
                        horizontal-stretch: 1;
                        height: 42px;
                        enabled: !root.delete-confirm-open;
                        clicked => { if (!root.delete-confirm-open) { root.new-note("note"); } }
                    }
                }

                Rectangle { height: 18px; background: transparent; }

                Rectangle {
                    height: 41px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: #e4e0d8;
                    background: InkTheme.paper;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 9px;
                        spacing: 6px;
                        Rectangle {
                            width: 20px;
                            height: 41px;
                            background: transparent;
                            SearchMark {
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 41px;
                            background: transparent;
                            search-editor := LineEdit {
                                width: parent.width;
                                height: 33px;
                                y: (parent.height - self.height) / 2;
                                font-size: 13px;
                                placeholder-text: "";
                                text <=> root.search-query;
                                edited(value) => { root.search(value); }
                            }
                            if root.search-query == "" && !search-editor.has-focus: Text {
                                x: 13px;
                                width: parent.width - 26px;
                                height: parent.height;
                                text: "Search pages";
                                color: #807b72;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                        }
                    }
                }

                Rectangle { height: 25px; background: transparent; }

                HorizontalLayout {
                    height: 21px;
                    spacing: 8px;
                    Rectangle {
                        width: 51px;
                        height: 21px;
                        background: transparent;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "PAGES";
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1.45px;
                            color: InkTheme.muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 60px;
                        height: 21px;
                        background: transparent;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.note-count + " items";
                            font-size: 11px;
                            color: root.muted;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 9px; background: transparent; }
                if root.filter-kind != "all": ActionButton {
                    width: 106px;
                    height: 28px;
                    subtle: true;
                    label: "Show all pages";
                    clicked => { root.set-filter("all"); }
                }
                Rectangle { height: 8px; background: transparent; }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for entry in root.rows: Rectangle {
                            height: 67px;
                            border-radius: 9px;
                            background: entry.active ? (InkTheme.dark ? #463c2d : #fbe9b9) : item-hit.has-hover ? (InkTheme.dark ? #303947 : #ece9e2) : transparent;
                            border-width: item-hit.has-focus ? 1px : 0px;
                            border-color: #c18b24;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 7px;
                                padding-top: 7px;
                                padding-bottom: 7px;
                                spacing: 3px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                    accessible-role: tab;
                                    accessible-label: entry.title + ", page";
                                    accessible-action-default => { root.select-note(entry.id); root.renaming = false; }
                                    forward-focus: item-hit;
                                    HorizontalLayout {
                                        spacing: 9px;
                                        padding-left: 6px;
                                        padding-right: 3px;
                                        Rectangle {
                                            width: 30px;
                                            height: 53px;
                                            background: transparent;
                                            DocumentMark {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                ink: entry.active ? #9f7422 : #a29a8a;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: entry.title == "" ? "Untitled" : entry.title;
                                                color: InkTheme.ink;
                                                font-weight: entry.active ? 700 : 600;
                                                font-size: 13px;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: entry.subtitle == "" ? (entry.kind == "board" ? "Drawing" : "Empty page") : entry.subtitle;
                                                color: InkTheme.muted;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }
                                        if entry.pinned: Rectangle {
                                            width: 9px;
                                            height: 53px;
                                            background: transparent;
                                            Rectangle {
                                                width: 6px;
                                                height: 6px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 3px;
                                                background: #a77e2c;
                                            }
                                        }
                                    }
                                    item-hit := KeyboardTarget {
                                        width: parent.width;
                                        height: parent.height;
                                        clicked => { root.select-note(entry.id); root.renaming = false; }
                                    }
                                }
                                Rectangle {
                                    width: 32px;
                                    height: 53px;
                                    background: transparent;
                                    DeleteRowButton {
                                        width: parent.width;
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        note-name: entry.title == "" ? "untitled page" : entry.title;
                                        clicked => { root.request-delete-note(entry.id); }
                                    }
                                }
                            }
                        }
                        if root.rows.length == 0: Rectangle {
                            height: 115px;
                            background: transparent;
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: root.note-count == 0 ? "No pages yet" : "No matching pages";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: InkTheme.muted;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.note-count == 0 ? "Create your first page to get started." : "Try another search, or create a page.";
                                    font-size: 11px;
                                    color: #a69f93;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 13px; background: transparent; }
                Rectangle { height: 1px; background: InkTheme.line; }
                Rectangle { height: 14px; background: transparent; }
                HorizontalLayout {
                    height: 29px;
                    spacing: 9px;
                    Rectangle {
                        width: 7px;
                        height: 29px;
                        background: transparent;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: #c9a54c;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 29px;
                        background: transparent;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Local workspace";
                            color: #77736b;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 46px;
                        height: 29px;
                        background: transparent;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "INKPAD";
                            color: #8e887d;
                            font-size: 9px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                }
            }
            if root.sidebar-collapsed: VerticalLayout {
                padding-top: 22px;
                padding-bottom: 16px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                Rectangle {
                    height: 44px;
                    background: transparent;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: #e7b443;
                        PencilMark {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            ink: #5d440d;
                        }
                    }
                }
                SidebarToggle {
                    width: 44px;
                    height: 42px;
                    collapsed: true;
                    enabled: !root.delete-confirm-open;
                    clicked => { if (!root.delete-confirm-open) { root.toggle-sidebar(); } }
                }
                Rectangle { height: 8px; background: transparent; }
                ActionButton {
                    width: 44px;
                    height: 42px;
                    label: "+";
                    accessible-name: "New page";
                    prominent: true;
                    enabled: !root.delete-confirm-open;
                    clicked => { if (!root.delete-confirm-open) { root.new-note("note"); } }
                }
                Rectangle {
                    width: 44px;
                    height: 42px;
                    border-radius: 9px;
                    background: search-hit.has-hover ? (InkTheme.dark ? #343c49 : #e7e3dc) : transparent;
                    accessible-role: button;
                    accessible-label: "Expand sidebar to search pages";
                    accessible-action-default => { root.toggle-sidebar(); }
                    SearchMark {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    search-hit := KeyboardTarget {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-sidebar(); }
                    }
                }
                Rectangle {
                    width: 44px;
                    height: 42px;
                    background: transparent;
                    accessible-role: button;
                    accessible-label: "Expand pages";
                    accessible-action-default => { root.toggle-sidebar(); }
                    DocumentMark {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        ink: #8b805f;
                    }
                    pages-hit := KeyboardTarget {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.toggle-sidebar(); }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    width: 44px;
                    height: 29px;
                    background: transparent;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.note-count + "";
                        color: InkTheme.muted;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { width: 1px; background: root.line; }

        // Editor and canvas share the same document header and save affordances.
        Rectangle {
            horizontal-stretch: 1;
            background: InkTheme.canvas;
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 47px;
                    background: InkTheme.toolbar;
                    HorizontalLayout {
                        padding-left: 31px;
                        padding-right: 29px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 9px;
                        Rectangle {
                            width: 77px;
                            height: 35px;
                            background: transparent;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "ALL NOTES";
                                color: InkTheme.muted;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.2px;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 9px;
                            height: 35px;
                            background: transparent;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "›";
                                font-size: 15px;
                                color: #c2b9a9;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 75px;
                            height: 35px;
                            background: transparent;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: !root.has-note ? "Welcome" : "Page";
                                color: root.ink;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 202px;
                            height: 35px;
                            background: transparent;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.save-status;
                                font-size: 11px;
                                color: root.muted;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if root.has-note: Rectangle {
                            width: 66px;
                            height: 35px;
                            background: transparent;
                            ActionButton {
                                width: parent.width;
                                height: 34px;
                                y: (parent.height - self.height) / 2;
                                label: "Save";
                                clicked => { root.save-now(); }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: root.line; }

                if root.has-note: VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 106px;
                        background: InkTheme.paper;
                        VerticalLayout {
                            padding-left: 33px;
                            padding-right: 29px;
                            padding-top: 13px;
                            padding-bottom: 11px;
                            spacing: 7px;
                            Text {
                                text: "YOUR PAGE";
                                color: InkTheme.muted;
                                font-size: 10px;
                                letter-spacing: 1.15px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                height: 45px;
                                spacing: 7px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                    if !root.renaming: Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.note-title == "" ? "Untitled page" : root.note-title;
                                        color: InkTheme.ink;
                                        font-size: 26px;
                                        font-weight: 700;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    if root.renaming: LineEdit {
                                        width: parent.width;
                                        height: parent.height;
                                        font-family: "Segoe UI";
                                        font-size: 20px;
                                        placeholder-text: "Page title";
                                        text <=> root.note-title;
                                        edited(value) => { root.rename-note(value); }
                                        accepted => { root.renaming = false; }
                                    }
                                }
                                Rectangle {
                                    width: 69px;
                                    height: 45px;
                                    background: transparent;
                                    ActionButton {
                                        width: parent.width;
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        label: root.renaming ? "Done" : "Rename";
                                        clicked => { root.renaming = !root.renaming; }
                                    }
                                }
                                Rectangle {
                                    width: 54px;
                                    height: 45px;
                                    background: transparent;
                                    ActionButton {
                                        width: parent.width;
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        label: "Pin";
                                        clicked => { root.toggle-pin(); }
                                    }
                                }
                                Rectangle {
                                    width: 71px;
                                    height: 45px;
                                    background: transparent;
                                    ActionButton {
                                        width: parent.width;
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        label: "Export";
                                        clicked => { root.export-current(); }
                                    }
                                }
                                Rectangle {
                                    width: 66px;
                                    height: 45px;
                                    background: transparent;
                                    ActionButton {
                                        width: parent.width;
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        label: "Delete";
                                        danger: true;
                                    clicked => { root.request-delete-note(""); }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.line; }
                    Rectangle {
                        height: 49px;
                        background: InkTheme.paper;
                        HorizontalLayout {
                            padding-left: 33px;
                            padding-right: 29px;
                            spacing: 7px;
                            ActionButton {
                                width: 85px;
                                height: 33px;
                                selected: root.edit-mode == "text";
                                label: "Text";
                                clicked => { root.edit-mode = "text"; root.set-edit-mode("text"); }
                            }
                            ActionButton {
                                width: 85px;
                                height: 33px;
                                selected: root.edit-mode == "draw";
                                label: "Draw";
                                clicked => { root.edit-mode = "draw"; root.set-edit-mode("draw"); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Rectangle {
                                width: 148px;
                                height: 33px;
                                background: transparent;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.edit-mode == "draw" ? "Sketch on this page" : "Write on this page";
                                    font-size: 11px;
                                    color: root.muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: root.line; }

                    if root.edit-mode == "text": VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 54px;
                            background: InkTheme.toolbar;
                            HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 24px;
                                spacing: 5px;
                                ToolLabel {
                                    width: 43px;
                                    label: "FONT";
                                    ink: root.muted;
                                }
                                ActionButton {
                                    width: 60px;
                                    height: 34px;
                                    subtle: true;
                                    selected: root.active-text-family == "Sans";
                                    label: "Sans";
                                    clicked => { root.change-font-choice("Sans"); root.restore-text-selection(); }
                                }
                                ActionButton {
                                    width: 60px;
                                    height: 34px;
                                    subtle: true;
                                    selected: root.active-text-family == "Serif";
                                    label: "Serif";
                                    clicked => { root.change-font-choice("Serif"); root.restore-text-selection(); }
                                }
                                ActionButton {
                                    width: 60px;
                                    height: 34px;
                                    subtle: true;
                                    selected: root.active-text-family == "Mono";
                                    label: "Mono";
                                    clicked => { root.change-font-choice("Mono"); root.restore-text-selection(); }
                                }
                                Rectangle { width: 8px; height: 34px; background: transparent; }
                                Rectangle {
                                    width: 1px;
                                    height: 34px;
                                    background: transparent;
                                    Rectangle {
                                        y: 5px;
                                        width: 1px;
                                        height: 24px;
                                        background: root.line;
                                    }
                                }
                                Rectangle { width: 6px; height: 34px; background: transparent; }
                                ToolLabel {
                                    width: 32px;
                                    label: "SIZE";
                                    ink: root.muted;
                                }
                                StepButton {
                                    width: 32px;
                                    height: 34px;
                                    hold-mode: true;
                                    enabled: (root.selected-text-size > 0 && root.selected-text-size > 12) ||
                                             (root.selected-text-size <= 0 && root.font-size > 12);
                                    clicked => { root.change-font-size(max(12, (root.selected-text-size > 0 ? root.selected-text-size : root.font-size) - 1)); }
                                }
                                Rectangle {
                                    width: 30px;
                                    height: 34px;
                                    background: transparent;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: (root.selected-text-size > 0 ? root.selected-text-size : root.font-size) + "";
                                        color: root.ink;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                StepButton {
                                    width: 32px;
                                    height: 34px;
                                    add: true;
                                    hold-mode: true;
                                    enabled: (root.selected-text-size > 0 && root.selected-text-size < 40) ||
                                             (root.selected-text-size <= 0 && root.font-size < 40);
                                    clicked => { root.change-font-size(min(40, (root.selected-text-size > 0 ? root.selected-text-size : root.font-size) + 1)); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ToolLabel {
                                    width: 83px;
                                    label: root.formatted-preview ? "FORMATTED" : "EDIT SOURCE";
                                    ink: root.muted;
                                }
                                ActionButton {
                                    width: 76px;
                                    height: 33px;
                                    label: root.formatted-preview ? "Edit text" : "Preview";
                                    selected: root.formatted-preview;
                                    accessible-name: root.formatted-preview ? "Return to text editing" : "Preview formatted note";
                                    clicked => {
                                        if (!root.formatted-preview) {
                                            root.request-formatted-preview();
                                        }
                                        root.formatted-preview = !root.formatted-preview;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.line; }
                        if !root.formatted-preview: Rectangle {
                            height: 48px;
                            background: InkTheme.toolbar;
                            HorizontalLayout {
                                padding-left: 23px;
                                padding-right: 23px;
                                spacing: 7px;
                                ToolLabel { width: 39px; label: "STYLE"; ink: root.muted; }
                                ActionButton {
                                    width: 38px;
                                    height: 31px;
                                    label: "B";
                                    accessible-name: "Bold selected text or typing style, Control Alt B";
                                    selected: root.selection-bold;
                                    clicked => { root.apply-text-format("bold"); root.restore-text-selection(); }
                                }
                                ActionButton {
                                    width: 32px;
                                    height: 31px;
                                    subtle: true;
                                    label: "↶";
                                    accessible-name: "Undo text change, Control Z";
                                    clicked => { root.undo-rich-edit(); }
                                }
                                ActionButton {
                                    width: 32px;
                                    height: 31px;
                                    subtle: true;
                                    label: "↷";
                                    accessible-name: "Redo text change, Control Y";
                                    clicked => { root.redo-rich-edit(); }
                                }
                                Rectangle { width: 1px; height: 26px; background: root.line; }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.selection-anchor-byte == root.selection-caret-byte ?
                                        "Place caret, then choose a style" :
                                        "Selected " + (max(root.format-start, root.format-end) - min(root.format-start, root.format-end)) + " characters";
                                    overflow: elide;
                                    font-size: 11px;
                                    color: root.selection-anchor-byte == root.selection-caret-byte ? InkTheme.muted : InkTheme.accent;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    width: 71px;
                                    height: 31px;
                                    subtle: true;
                                    selected: root.advanced-text-range;
                                    label: "Range…";
                                    accessible-name: root.advanced-text-range ? "Hide advanced manual character range" : "Show advanced manual character range";
                                    clicked => { root.advanced-text-range = !root.advanced-text-range; }
                                }
                                ToolLabel { width: 32px; label: "INK"; ink: root.muted; }
                                for tone in [
                                    {name: "Ink", code: "#292927", paint: #292927},
                                    {name: "Red", code: "#D74453", paint: #d74453},
                                    {name: "Orange", code: "#EF8E42", paint: #ef8e42},
                                    {name: "Green", code: "#158E89", paint: #158e89},
                                    {name: "Blue", code: "#386CC5", paint: #386cc5},
                                    {name: "Violet", code: "#8B6AB8", paint: #8b6ab8}
                                ]: ColorDot {
                                    category: "text colour";
                                    width: 27px;
                                    height: 27px;
                                    label: tone.name;
                                    value: tone.code;
                                    paint: tone.paint;
                                    selected: root.text-color == tone.code;
                                    picked(value) => { root.apply-text-color(value); root.restore-text-selection(); }
                                }
                            }
                        }
                        if !root.formatted-preview && root.advanced-text-range: Rectangle {
                            height: 45px;
                            background: InkTheme.secondary;
                            HorizontalLayout {
                                padding-left: 23px;
                                padding-right: 23px;
                                spacing: 9px;
                                ToolLabel { width: 101px; label: "MANUAL RANGE"; ink: root.muted; }
                                SpinBox {
                                    width: 78px;
                                    height: 31px;
                                    minimum: 0;
                                    maximum: 1000000;
                                    value <=> root.format-start;
                                    accessible-label: "Unicode character offset for start of formatting range";
                                }
                                Text { width: 16px; text: "–"; color: root.muted; horizontal-alignment: center; vertical-alignment: center; }
                                SpinBox {
                                    width: 78px;
                                    height: 31px;
                                    minimum: 0;
                                    maximum: 1000000;
                                    value <=> root.format-end;
                                    accessible-label: "Exclusive Unicode character offset for end of formatting range";
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Advanced fallback · character positions, end exclusive";
                                    color: root.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                LineEdit {
                                    width: 96px;
                                    height: 30px;
                                    text <=> root.custom-text-color;
                                    placeholder-text: "#RRGGBB";
                                    accessible-label: "Custom text colour hex, press Enter to apply";
                                    accepted => { root.apply-text-color(self.text); }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.line; }
                        Rectangle {
                            vertical-stretch: 1;
                            background: InkTheme.paper;
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 0px;
                                width: min(parent.width - 32px, 900px);
                                height: parent.height;
                                background: InkTheme.paper;
                                // Direct TextInput avoids the styled TextEdit's implicit sizing:
                                // its geometry and ink colour are fixed relative to this page.
                                body-scroll := ScrollView {
                                    visible: !root.formatted-preview;
                                    x: 36px;
                                    y: 25px;
                                    width: parent.width - 72px;
                                    height: parent.height - 50px;
                                    content-width: self.visible-width;
                                    content-height: max(self.visible-height, body-input.preferred-height + 12px);

                                    body-input := TextInput {
                                        private property <int> restore-request: root.restore-editor-token;
                                        changed has-focus => { root.text-editor-focused = self.has-focus; }
                                        changed restore-request => {
                                            if (root.edit-mode == "text" && !root.formatted-preview) {
                                                self.focus();
                                                self.set-selection-offsets(root.selection-anchor-byte, root.selection-caret-byte);
                                            }
                                        }
                                        width: body-scroll.visible-width;
                                        height: max(body-scroll.visible-height, self.preferred-height + 12px);
                                        text <=> root.note-body;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-size: root.font-size * 1px;
                                        font-family: root.font-choice == "Serif" || root.font-choice == "Georgia" ? "Georgia" : root.font-choice == "Mono" || root.font-choice == "Consolas" ? "Consolas" : "Segoe UI";
                                        color: InkTheme.ink;
                                        selection-background-color: #f2d889;
                                        selection-foreground-color: InkTheme.ink;
                                        vertical-alignment: top;
                                        key-pressed(event) => {
                                            if (event.modifiers.control && !event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                                return root.copy-rich-selection() ? accept : reject;
                                            }
                                            if (event.modifiers.control && !event.modifiers.alt && (event.text == "x" || event.text == "X")) {
                                                return root.cut-rich-selection() ? accept : reject;
                                            }
                                            if (event.modifiers.control && !event.modifiers.alt && (event.text == "v" || event.text == "V")) {
                                                return root.paste-rich-selection() ? accept : reject;
                                            }
                                            if (event.modifiers.control && !event.modifiers.alt && (event.text == "z" || event.text == "Z")) {
                                                if (event.modifiers.shift) {
                                                    root.redo-rich-edit();
                                                } else {
                                                    root.undo-rich-edit();
                                                }
                                                return accept;
                                            }
                                            if (event.modifiers.control && !event.modifiers.alt && (event.text == "y" || event.text == "Y")) {
                                                root.redo-rich-edit();
                                                return accept;
                                            }
                                            return reject;
                                        }
                                        edited => { root.edit-body(self.text); }
                                        changed cursor-position-byte-offset => {
                                            root.selection-caret-byte = self.cursor-position-byte-offset;
                                            root.selection-anchor-byte = self.anchor-position-byte-offset;
                                            root.select-body-range(root.selection-anchor-byte, root.selection-caret-byte);
                                        }
                                        changed anchor-position-byte-offset => {
                                            root.selection-anchor-byte = self.anchor-position-byte-offset;
                                            root.selection-caret-byte = self.cursor-position-byte-offset;
                                            root.select-body-range(root.selection-anchor-byte, root.selection-caret-byte);
                                        }
                                    }
                                }
                                if !root.formatted-preview && root.note-body == "": Text {
                                    x: 36px;
                                    y: 25px;
                                    width: parent.width - 72px;
                                    text: "Start writing something...";
                                    color: InkTheme.subtle;
                                    font-size: root.font-size * 1px;
                                    vertical-alignment: top;
                                    accessible-role: none;
                                }
                                if root.formatted-preview && (!root.rich-preview-exact || root.rich-preview-paragraphs.length == 0): ScrollView {
                                    x: 36px;
                                    y: 25px;
                                    width: parent.width - 72px;
                                    height: parent.height - 50px;
                                    content-width: self.visible-width;
                                    content-height: max(self.visible-height, rich-render.preferred-height + 12px);
                                    rich-render := StyledText {
                                        width: parent.width;
                                        height: max(parent.height, self.preferred-height + 12px);
                                        text: root.note-styled-preview;
                                        default-font-family: root.font-choice == "Serif" || root.font-choice == "Georgia" ? "Georgia" : root.font-choice == "Mono" || root.font-choice == "Consolas" ? "Consolas" : "Segoe UI";
                                        default-font-size: root.font-size * 1px;
                                        default-color: InkTheme.ink;
                                        link-color: InkTheme.dark ? #a8c8ff : #285bb2;
                                        vertical-alignment: top;
                                    }
                                }
                                if root.formatted-preview && root.rich-preview-exact && root.rich-preview-paragraphs.length > 0: ScrollView {
                                    x: 36px;
                                    y: 25px;
                                    width: parent.width - 72px;
                                    height: parent.height - 50px;
                                    content-width: self.visible-width;
                                    content-height: max(self.visible-height, rich-visual-body.preferred-height + 12px);
                                    rich-visual-body := VerticalLayout {
                                        width: parent.visible-width;
                                        spacing: 0px;
                                        for paragraph in root.rich-preview-paragraphs: FlexboxLayout {
                                            width: parent.width;
                                            height: max(self.preferred-height, root.font-size * 1.45px);
                                            flex-wrap: wrap;
                                            spacing-horizontal: 0px;
                                            spacing-vertical: 0px;
                                            cross-axis-alignment: end;
                                            for span in paragraph.spans: Text {
                                                text: span.text;
                                                font-size: max(8, span.size) * 1px;
                                                font-family: span.family;
                                                font-weight: span.bold ? 700 : 400;
                                                color: span.has_foreground ? span.foreground : InkTheme.ink;
                                                width: min(self.preferred-width, parent.width);
                                                height: self.preferred-height;
                                                wrap: word-wrap;
                                                vertical-alignment: bottom;
                                            }
                                        }
                                    }
                                }
                                if root.formatted-preview: Text {
                                    x: 36px;
                                    y: 3px;
                                    width: parent.width - 72px;
                                    height: 16px;
                                    text: root.rich-preview-exact && root.rich-preview-paragraphs.length > 0
                                        ? "Formatted preview · individual fonts and sizes; line wrapping may differ from the editor."
                                        : "Preview shows emphasis and colour. Inline font and size use page defaults.";
                                    color: InkTheme.subtle;
                                    font-size: 10px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: root.line; }
                        Rectangle {
                            height: 54px;
                            background: InkTheme.toolbar;
                            HorizontalLayout {
                                padding-left: 26px;
                                padding-right: 26px;
                                spacing: 8px;
                                ToolLabel {
                                    width: 93px;
                                    label: "PICTURES";
                                    ink: #686159;
                                }
                                Text {
                                    text: root.media-rows.length + " on page";
                                    color: root.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ActionButton {
                                    width: 96px;
                                    height: 33px;
                                    label: "Paste image";
                                    accessible-name: "Paste image from clipboard, Control V";
                                    clicked => { root.paste-image(); }
                                }
                                ActionButton {
                                    width: 99px;
                                    height: 33px;
                                    prominent: true;
                                    label: "Add picture";
                                    accessible-name: "Insert image file";
                                    clicked => { root.insert-image-file(); }
                                }
                                ActionButton {
                                    width: 100px;
                                    height: 33px;
                                    label: "Export page";
                                    accessible-name: "Export page with pictures";
                                    clicked => { root.export-page(); }
                                }
                            }
                        }
                        if root.media-rows.length > 0: Rectangle {
                            vertical-stretch: 1;
                            background: InkTheme.secondary;
                            ScrollView {
                                x: (parent.width - self.width) / 2;
                                y: 0px;
                                width: min(parent.width - 36px, 910px);
                                height: parent.height;
                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 13px;
                                    padding-bottom: 18px;
                                    spacing: 11px;
                                    for media in root.media-rows: MediaCard {
                                        horizontal-stretch: 1;
                                        media-id: media.id;
                                        caption: media.caption;
                                        width-percent: media.width-percent;
                                        position: media.position;
                                        preview: media.preview;
                                        selected: root.selected-media-id == media.id;
                                        can-move-up: media.position > 0;
                                        can-move-down: media.position < root.media-rows.length - 1;
                                        chosen(id) => { root.selected-media-id = id; root.select-media(id); }
                                        resized(id, size) => { root.resize-media(id, size); }
                                        moved(id, direction) => { root.move-media(id, direction); }
                                        removed(id) => { root.delete-media(id); }
                                        caption-changed(id, value) => { root.caption-media(id, value); }
                                    }
                                }
                            }
                        }
                    }

                    if root.edit-mode == "draw": VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 102px;
                            background: InkTheme.toolbar;
                            VerticalLayout {
                              spacing: 0px;
                              HorizontalLayout {
                                height: 52px;
                                padding-left: 23px;
                                padding-right: 23px;
                                spacing: 7px;
                                ActionButton {
                                    width: 62px;
                                    height: 34px;
                                    selected: !root.eraser;
                                    label: "Pen";
                                    clicked => { root.set-eraser(false); }
                                }
                                ActionButton {
                                    width: 64px;
                                    height: 34px;
                                    selected: root.eraser;
                                    label: "Eraser";
                                    clicked => { root.set-eraser(true); }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 34px;
                                    background: transparent;
                                    Rectangle { y: 5px; width: 1px; height: 24px; background: root.line; }
                                }
                                StepButton {
                                    width: 29px;
                                    height: 34px;
                                    hold-mode: true;
                                    enabled: root.brush-size > 1;
                                    clicked => { root.set-brush-size(max(1, root.brush-size - 1)); }
                                }
                                Rectangle {
                                    width: 35px;
                                    height: 34px;
                                    background: transparent;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.brush-size + " px";
                                        color: root.ink;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                StepButton {
                                    width: 29px;
                                    height: 34px;
                                    add: true;
                                    hold-mode: true;
                                    enabled: root.brush-size < 40;
                                    clicked => { root.set-brush-size(min(40, root.brush-size + 1)); }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 34px;
                                    background: transparent;
                                    Rectangle { y: 5px; width: 1px; height: 24px; background: root.line; }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ActionButton {
                                    width: 55px;
                                    height: 34px;
                                    label: "Undo";
                                    clicked => { root.undo-board(); }
                                }
                                ActionButton {
                                    width: 58px;
                                    height: 34px;
                                    danger: true;
                                    label: "Clear";
                                    clicked => { root.request-clear-board(); }
                                }
                              }
                              Rectangle { height: 1px; background: root.line; }
                              HorizontalLayout {
                                height: 49px;
                                padding-left: 23px;
                                padding-right: 23px;
                                spacing: 4px;
                                ToolLabel { width: 66px; label: "COLOURS"; ink: #70685c; }
                                for color in [
                                    {name: "Ink", code: "#263238", paint: #263238},
                                    {name: "Black", code: "#111111", paint: #111111},
                                    {name: "Slate", code: "#667085", paint: #667085},
                                    {name: "Silver", code: "#B6BCC7", paint: #b6bcc7},
                                    {name: "White", code: "#FFFFFF", paint: #ffffff},
                                    {name: "Ruby", code: "#D74453", paint: #d74453},
                                    {name: "Coral", code: "#E76E60", paint: #e76e60},
                                    {name: "Orange", code: "#EF8E42", paint: #ef8e42},
                                    {name: "Amber", code: "#E7B341", paint: #e7b341},
                                    {name: "Lemon", code: "#F0D964", paint: #f0d964},
                                    {name: "Green", code: "#61A366", paint: #61a366},
                                    {name: "Mint", code: "#9FDCC5", paint: #9fdcc5},
                                    {name: "Teal", code: "#158E89", paint: #158e89},
                                    {name: "Sky", code: "#6EB8E9", paint: #6eb8e9},
                                    {name: "Blue", code: "#386CC5", paint: #386cc5},
                                    {name: "Indigo", code: "#555AA9", paint: #555aa9},
                                    {name: "Violet", code: "#8B6AB8", paint: #8b6ab8},
                                    {name: "Pink", code: "#EAA1C8", paint: #eaa1c8}
                                ]: Rectangle {
                                    width: 29px;
                                    height: 34px;
                                    background: transparent;
                                    ColorDot {
                                        y: (parent.height - self.height) / 2;
                                        label: color.name;
                                        value: color.code;
                                        paint: color.paint;
                                        selected: !root.eraser && root.brush-color == color.code;
                                        picked(value) => { root.set-eraser(false); root.set-brush-color(value); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                              }
                            }
                        }
                        Rectangle { height: 1px; background: root.line; }
                        Rectangle {
                            vertical-stretch: 1;
                            background: InkTheme.secondary;
                            board-sheet := Rectangle {
                                width: min(parent.width - 72px, (parent.height - 62px) * 11 / 7);
                                height: self.width * 7 / 11;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                background: #ffffff;
                                border-color: #e1ddd3;
                                border-width: 1px;
                                clip: true;
                                Image {
                                    source: root.canvas-image;
                                    image-fit: fill;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                board-hit := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: crosshair;
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            root.draw-at(Math.round((self.mouse-x / self.width) * 1100), Math.round((self.mouse-y / self.height) * 700), 0);
                                        }
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                            root.draw-at(Math.round((self.mouse-x / self.width) * 1100), Math.round((self.mouse-y / self.height) * 700), 2);
                                        }
                                        if (event.kind == PointerEventKind.cancel) {
                                            root.draw-at(Math.round((self.mouse-x / self.width) * 1100), Math.round((self.mouse-y / self.height) * 700), 2);
                                        }
                                    }
                                    moved => {
                                        root.draw-at(Math.round((self.mouse-x / self.width) * 1100), Math.round((self.mouse-y / self.height) * 700), 1);
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 40px;
                            background: InkTheme.toolbar;
                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                Text {
                                    text: "1100 × 700 CANVAS";
                                    color: InkTheme.subtle;
                                    font-weight: 700;
                                    font-size: 10px;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text {
                                    text: root.eraser ? "Erase on canvas" : "Drag on canvas to draw";
                                    font-size: 11px;
                                    color: InkTheme.subtle;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if !root.has-note: Rectangle {
                    vertical-stretch: 1;
                    background: InkTheme.canvas;
                    Rectangle {
                        width: min(parent.width - 64px, 420px);
                        height: 325px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        VerticalLayout {
                            spacing: 12px;
                            Rectangle {
                                height: 74px;
                                background: transparent;
                                    Rectangle {
                                        width: 60px;
                                        height: 60px;
                                        x: (parent.width - self.width) / 2;
                                        y: 6px;
                                        border-radius: 14px;
                                        background: #f2e8d2;
                                        DocumentMark {
                                            width: 25px;
                                            height: 25px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            ink: #8f784e;
                                        }
                                }
                            }
                            Text {
                                text: "Start a new page";
                                font-family: "Segoe UI";
                                color: InkTheme.ink;
                                font-size: 25px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "A space for notes and sketches. Everything stays on this device.";
                                color: InkTheme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            Rectangle { height: 7px; background: transparent; }
                            HorizontalLayout {
                                spacing: 11px;
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ActionButton {
                                    width: 156px;
                                    height: 40px;
                                    prominent: true;
                                    label: "New page";
                                    enabled: !root.delete-confirm-open;
                                    clicked => { if (!root.delete-confirm-open) { root.new-note("note"); } }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    }
    modal-screen := Rectangle {
        visible: root.delete-confirm-open;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #17130e88;
        accessible-role: none;
        // Own the focused controls and consume traversal before Slint can move
        // focus into window chrome, the sidebar, or the underlying editor.
        modal-keys := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.delete-confirm-open;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-delete();
                return accept;
            }
            if (event.text == Key.Tab) {
                if (modal-cancel.has-keyboard-focus) {
                    modal-confirm.focus-button();
                } else {
                    modal-cancel.focus-button();
                }
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-delete();
                return accept;
            }
            if (event.text == Key.Tab) {
                if (modal-cancel.has-keyboard-focus) {
                    modal-confirm.focus-button();
                } else {
                    modal-cancel.focus-button();
                }
                return accept;
            }
            return reject;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.cancel-delete(); }
        }
        Rectangle {
            width: 438px;
            height: 211px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: InkTheme.paper;
            border-radius: 16px;
            border-width: 1px;
            border-color: InkTheme.line;
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { }
            }
            VerticalLayout {
                padding-top: 25px;
                padding-bottom: 24px;
                padding-left: 28px;
                padding-right: 28px;
                spacing: 10px;
                Text {
                    text: root.delete-confirm-title == "" ? "Delete this page?" : root.delete-confirm-title;
                    font-size: 21px;
                    font-weight: 700;
                    color: InkTheme.ink;
                }
                Text {
                    text: root.delete-confirm-body == "" ? "This page will be permanently deleted." : root.delete-confirm-body;
                    font-size: 13px;
                    color: InkTheme.muted;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    height: 38px;
                    spacing: 9px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    modal-cancel := ActionButton {
                        width: 100px;
                        height: 38px;
                        label: "Cancel";
                        clicked => { root.cancel-delete(); }
                    }
                    modal-confirm := ActionButton {
                        width: 128px;
                        height: 38px;
                        label: root.confirm-action-label;
                        destructive: true;
                        clicked => { root.confirm-delete(); }
                    }
                }
            }
        }
        }
    }
}
